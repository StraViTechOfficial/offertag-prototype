{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/deal/:slug", "destination": "/_shell/deal/index.html" },
    { "source": "/products/:slug", "destination": "/_shell/products/index.html" },
    { "source": "/shops/:shop/:cat", "destination": "/_shell/combo/index.html" },
    { "source": "/shops/:shop", "destination": "/_shell/shops/index.html" },
    { "source": "/blog/:slug", "destination": "/_shell/blog/index.html" },
    { "source": "/admin/deal/:id/:mode", "destination": "/_shell/adm-deal/index.html" },
    { "source": "/admin/blog/:slug/edit", "destination": "/_shell/adm-blog/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
